#!/bin/sh
set -e
id ssc >/dev/null 2>&1 || useradd --system --home-dir /var/lib/ssc --shell /usr/sbin/nologin --user-group ssc
install -d -o ssc -g ssc -m 750 /var/lib/ssc
usermod -aG systemd-journal ssc 2>/dev/null || true      # the admin panel's log viewer
systemctl enable ssc-server.service ssc-apply.path ssc-banner.service ssc-sync.timer ssc-health.timer ssc-schedule-boot.service ssc-live-console.service ssc-autoinstall.service nftables.service ssh.service
# tty1 keeps its normal login prompt; on the live medium ssc-live-console.service takes the screen over (the getty is switched off there by a drop-in, see getty@tty1.service.d/10-ssc-live.conf)
systemctl enable getty@tty1.service
# Wi-Fi is started by ifupdown (wpa-conf); the standalone wpa_supplicant service would fight with it
systemctl mask wpa_supplicant.service 2>/dev/null || true
# a server: never suspend (the lid and the sleep keys are also ignored by the logind drop-in in the overlay)
systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target
# fresh machine-id and host keys are made on first boot / by the installer
rm -f /etc/ssh/ssh_host_* /etc/machine-id
touch /etc/machine-id
# sensible default: SSH on, root login off (the admin can change this with ssconfig)
printf 'PermitRootLogin no\n' > /etc/ssh/sshd_config.d/ssc.conf
# the interfaces file must include the file ssconfig writes
grep -q 'interfaces.d' /etc/network/interfaces 2>/dev/null || echo 'source /etc/network/interfaces.d/*' >> /etc/network/interfaces
# live medium: let the live user sudo without a password only on the live session (removed with live-config on install)
